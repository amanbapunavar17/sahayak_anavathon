# SAHAYAK — Environment Configuration Template
# Copy this file to .env (e.g. `cp .env.example .env`) and add your Gemini API Key.
# DO NOT COMMIT YOUR ACTUAL .env FILE!

# ==============================================================================
# 1. AI REASONING MODEL (Google Gemini 3.8 Flash)
# Get a free API key at: https://aistudio.google.com
# ==============================================================================
GEMINI_API_KEY=

# ==============================================================================
# 2. LOCAL ACCESSIBILITY & SPEECH SETTINGS (100% Free & Local)
# ==============================================================================
# Preferred macOS Speech voice (e.g. Samantha, Alex, Aman, Fred, Victoria)
SAHAYAK_TTS_VOICE=Samantha

# Speech rate in words per minute (normal is 180-190)
SAHAYAK_TTS_RATE=180

# Local Whisper Speech-to-Text model size (tiny.en, base.en, small.en)
SAHAYAK_WHISPER_MODEL=tiny.en

# Server Host and Port
HOST=127.0.0.1
PORT=8080

