# SAHAYAK Server — Environment Configuration
# Copy to server/.env or keep in project root .env

# Google Gemini API Key (Preferred model: gemini-3.8-flash)
# Obtain your free key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# Local macOS Speech Synthesis voice
SAHAYAK_TTS_VOICE=Samantha
SAHAYAK_TTS_RATE=180

# Local Whisper model (tiny.en, base.en)
SAHAYAK_WHISPER_MODEL=tiny.en

# Server network binding
HOST=127.0.0.1
PORT=8080
